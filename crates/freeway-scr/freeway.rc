// Resources of the screensaver: the display name, the icon, the settings
// dialog, the manifest and the version information.
//
// VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH and VERSION_TEXT (a quoted
// string) are defined by build.rs from the version in Cargo.toml.
//
// Why: no #include of Windows headers. embed-resource passes only its output
// directory to the resource compiler as an include path, and INCLUDE may be
// unset outside a Visual Studio prompt, so the constants that are needed are
// written out here instead. The control IDs must match
// crates/freeway-scr/src/win/settings_dialog.rs.

// STYLE of the dialog: WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME |
// DS_SHELLFONT | DS_CENTER
#define DIALOG_STYLE 0x80C808C8
// WS_CHILD | WS_VISIBLE | WS_TABSTOP | TBS_AUTOTICKS
#define SLIDER_STYLE 0x50010001
// WS_CHILD | WS_VISIBLE | WS_GROUP | SS_RIGHT
#define VALUE_STYLE 0x50020002
// WS_TABSTOP | WS_GROUP, for the first radio button
#define GROUP_START 0x00030000
// WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
#define DROPDOWN_STYLE 0x50210003
// WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL | ES_NUMBER
#define MINUTES_STYLE 0x50012080
// WS_EX_CLIENTEDGE
#define MINUTES_EXSTYLE 0x00000200

// RT_MANIFEST (24) with the ID of a manifest for the executable (1)
1 24 "resources/freeway.manifest"

// The icon of the .scr file in Explorer. Windows uses the icon group with the
// lowest ID, so this must stay the only (or the lowest) icon. Generated by
// `cargo xtask icon`.
1 ICON "resources/freeway.ico"

// The version information that Explorer shows in the Details tab of the file
// properties. 0x0409 is English (United States), 1200 is Unicode.
1 VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS          0x00040004
FILETYPE        0x00000001
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Night Freeway SS"
            VALUE "FileVersion",      VERSION_TEXT
            VALUE "InternalName",     "NightFreewaySS"
            VALUE "LegalCopyright",   "Copyright (c) 2026 suchi"
            VALUE "OriginalFilename", "NightFreewaySS.scr"
            VALUE "ProductName",      "Night Freeway SS"
            VALUE "ProductVersion",   VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// The name in the screensaver list of the Settings app and Control Panel.
// Windows reads the string with ID 1 of the .scr file, not its file name.
STRINGTABLE
BEGIN
    1 "Night Freeway SS"
END

// The strings below are only the initial text (English). The settings dialog
// sets every string from freeway-core's string table when it opens and when
// the language changes (docs/adr/0007-localize-ui-strings-in-code.md), so
// controls with text that changes have an ID.
100 DIALOGEX 0, 0, 224, 322
STYLE DIALOG_STYLE
CAPTION "Night Freeway SS Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Mode:", 134, 12, 14, 56, 8
    CONTROL         "", 135, "COMBOBOX", DROPDOWN_STYLE, 70, 12, 142, 40
    LTEXT           "Cruising speed:", 108, 12, 28, 100, 8
    CONTROL         "", 101, "msctls_trackbar32", SLIDER_STYLE, 8, 40, 150, 20
    CONTROL         "", 102, "STATIC", VALUE_STYLE, 164, 44, 48, 8
    LTEXT           "Driving side:", 109, 12, 66, 100, 8
    AUTORADIOBUTTON "Left-hand traffic", 103, 12, 78, 96, 10, GROUP_START
    AUTORADIOBUTTON "Right-hand traffic", 104, 112, 78, 96, 10
    LTEXT           "Speedometer:", 121, 12, 98, 56, 8
    CONTROL         "", 105, "COMBOBOX", DROPDOWN_STYLE, 70, 96, 142, 70
    AUTOCHECKBOX    "Show a UFO now and then", 106, 12, 116, 160, 10
    AUTOCHECKBOX    "Show distant mountains", 111, 12, 130, 160, 10
    AUTOCHECKBOX    "Vary the cruising speed", 116, 12, 144, 200, 10
    AUTOCHECKBOX    "Traffic follows the time of day", 117, 12, 158, 200, 10
    AUTOCHECKBOX    "Alternate mountains and plains", 118, 12, 172, 200, 10
    AUTOCHECKBOX    "Span all monitors as one screen", 133, 12, 186, 200, 10
    LTEXT           "Trucks:", 112, 12, 204, 56, 8
    CONTROL         "", 113, "COMBOBOX", DROPDOWN_STYLE, 70, 202, 142, 60
    LTEXT           "Tunnels:", 114, 12, 220, 56, 8
    CONTROL         "", 115, "COMBOBOX", DROPDOWN_STYLE, 70, 218, 142, 60
    LTEXT           "Car bodies:", 119, 12, 236, 56, 8
    CONTROL         "", 120, "COMBOBOX", DROPDOWN_STYLE, 70, 234, 142, 70
    LTEXT           "Body color:", 122, 12, 252, 56, 8
    CONTROL         "", 123, "COMBOBOX", DROPDOWN_STYLE, 70, 250, 142, 60
    LTEXT           "Lane changes:", 131, 12, 268, 56, 8
    CONTROL         "", 132, "COMBOBOX", DROPDOWN_STYLE, 70, 266, 142, 60
    LTEXT           "Language:", 110, 12, 284, 56, 8
    CONTROL         "", 107, "COMBOBOX", DROPDOWN_STYLE, 70, 282, 142, 60
    PUSHBUTTON      "Keep running...", 124, 12, 302, 72, 14
    DEFPUSHBUTTON   "OK", 1, 108, 302, 50, 14
    PUSHBUTTON      "Cancel", 2, 162, 302, 50, 14
END

// The dialog that the "Keep running..." button of the settings dialog opens: how
// to run the road as something other than a screensaver. The strings are set
// from freeway-core's string table when it opens.
200 DIALOGEX 0, 0, 200, 98
STYLE DIALOG_STYLE
CAPTION "Keep it running"
FONT 9, "Segoe UI"
BEGIN
    AUTORADIOBUTTON "In a window", 125, 12, 12, 90, 10, GROUP_START
    AUTORADIOBUTTON "Full screen", 126, 106, 12, 82, 10
    LTEXT           "Close after (min, 0 = never):", 127, 12, 32, 120, 8
    CONTROL         "", 128, "EDIT", MINUTES_STYLE, 136, 29, 28, 12, MINUTES_EXSTYLE
    LTEXT           "Esc ends the run.", 130, 12, 50, 176, 8
    DEFPUSHBUTTON   "Start", 129, 88, 72, 50, 14
    PUSHBUTTON      "Cancel", 2, 142, 72, 50, 14
END
